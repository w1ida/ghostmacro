{
    "dependencies": {
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "description": "GhostMacro — VBA Séance. Resurrect dead Excel VBA macros as a working modern TypeScript React web app. Kiroween 2026, Frankenstein.",
    "devDependencies": {
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.0",
        "@types/node": "^26.6.6",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^4.3.1",
        "fast-check": "^3.22.0",
        "jsdom": "^26.1.0",
        "typescript": "^5.5.4",
        "vite": "^5.4.0",
        "vitest": "^2.0.5"
    },
    "engines": {
        "node": ">=18"
    },
    "license": "MIT",
    "name": "ghostmacro",
    "private": false,
    "scripts": {
        "build": "tsc -b && vite build",
        "dev": "vite",
        "lint": "eslint src --ext .ts,.tsx || true",
        "preview": "vite preview",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit"
    },
    "type": "module",
    "version": "0.1.0"
